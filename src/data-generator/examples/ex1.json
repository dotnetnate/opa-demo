{
    "policyId": "00000000-0000-0000-0000-000000000000",
    "policyDescription": "Example XACML-aligned access control policy with obligations and advice",
    "resource": {
        "resourceId": "account-123",
        "resourceType": "account"
    },
    "rules": [
        {
            "subject": {
                "identifier": "user-456",
                "authority": "https://auth0.com/"
            },
            "privileges": {
                "READ": {
                    "combiningAlgorithm": "firstApplicable",
                    "effectRules": [
                        {
                            "effect": "permit",
                            "conditions": [],
                            "obligations": [
                                {
                                    "type": "logging",
                                    "parameters": {
                                        "level": "info",
                                        "category": "account-access"
                                    }
                                }
                            ],
                            "advice": []
                        }
                    ],
                    "defaultEffect": "deny"
                },
                "WIRE_TRANSFER": {
                    "combiningAlgorithm": "firstApplicable",
                    "effectRules": [
                        {
                            "effect": "permit",
                            "conditions": [
                                {
                                    "attribute": "amount",
                                    "operator": "lt",
                                    "value": 10000
                                }
                            ],
                            "obligations": [
                                {
                                    "type": "logging",
                                    "parameters": {
                                        "level": "info",
                                        "category": "financial-transaction"
                                    }
                                }
                            ],
                            "advice": []
                        },
                        {
                            "effect": "permit",
                            "conditions": [
                                {
                                    "attribute": "amount",
                                    "operator": "gte",
                                    "value": 10000
                                },
                                {
                                    "attribute": "amount",
                                    "operator": "lt",
                                    "value": 100000
                                }
                            ],
                            "obligations": [
                                {
                                    "type": "approval",
                                    "parameters": {
                                        "approvalType": "manager",
                                        "minApprovers": 1
                                    }
                                },
                                {
                                    "type": "logging",
                                    "parameters": {
                                        "level": "warning",
                                        "category": "high-value-transaction"
                                    }
                                }
                            ],
                            "advice": [
                                {
                                    "type": "monitor",
                                    "parameters": {
                                        "flagForReview": true,
                                        "riskScore": "medium"
                                    }
                                }
                            ]
                        },
                        {
                            "effect": "deny",
                            "conditions": [
                                {
                                    "attribute": "amount",
                                    "operator": "gte",
                                    "value": 100000
                                }
                            ],
                            "obligations": [
                                {
                                    "type": "notification",
                                    "parameters": {
                                        "recipient": "security-team",
                                        "reason": "Transfer amount exceeds user limit"
                                    }
                                }
                            ],
                            "advice": []
                        }
                    ],
                    "defaultEffect": "deny"
                },
                "WRITE": {
                    "combiningAlgorithm": "firstApplicable",
                    "effectRules": [
                        {
                            "effect": "deny",
                            "conditions": [
                                {
                                    "attribute": "status",
                                    "operator": "neq",
                                    "value": "active"
                                }
                            ],
                            "obligations": [],
                            "advice": []
                        }
                    ],
                    "defaultEffect": "permit"
                }
            }
        }
    ]
}